KAFKA_TOPIC=user-events
KAFKA_SERVER=localhost:9092
KAFKA_GROUP_ID=user-events-feature-consumer
SESSION_IDLE_TIMEOUT_SEC=3

DB_HOST=localhost
DB_PORT=5432
DB_NAME=realtime_ecommerce
DB_USER=postgres
DB_PASSWORD=postgres

# Online deployments can use this instead of DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
DATABASE_URL=

# Comma-separated frontend origins allowed by FastAPI CORS.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5175,http://localhost:5173,http://localhost:5175,https://bitirme-frontend.onrender.com

# Set true only for online demo deployments without Kafka workers.
ENABLE_DEMO_PRODUCER=false
ONLINE_DEMO_SLEEP_SEC=5
ONLINE_DEMO_MIN_SESSIONS=100
